namespace es_tipolisto_arkandroid;

class Player implements GL_sprite{
	properties:
		game=null;
		score=0;
		high_score=0;
		lives=0;
		_player2=false;
		type="normal";
		timer_return_normal=null;
		time_to_normal=20;
		timer_is_actuve=false;
		counter_bombs=10;
		shields=3;
	virtual _operator_new(_name,_creator,_params){
		game=_params[0];
		_x=_params[1];
		_y=_params[2];
		_player2=_params[3];
		
		Addanimationwithsheet("normal","res/player.png",0,0,80*0,20*0,80,20);
		Addanimationwithsheet("laser","res/player.png",0,0,80*0,20*1,80,20);
		Addanimationwithsheet("shield","res/player.png",0,0,80*0,20*2,80,20);
		SetAnimation("normal");
		SetPos(_x,_y);	
		lives=5;
		score=0;
		SetCollision(True);	
		Setcollidermode(true);
		

		high_score=GetApp().db.get_max_player();
		if(high_score==null) high_score=0;
		
	}
	virtual Move(){
		
		_incrementoX=0;
		
		if (GetApp().pad.IsButton(PAD_BUTTON_RIGHT))_incrementoX=4;		
		else if (GetApp().pad.IsButton(PAD_BUTTON_LEFT))	_incrementoX=-4;			
		
		if(type=="laser"){
			if(GetApp().pad.IsButtonDown(PAD_BUTTON_1)){
				 GetApp().resources.PlaySoundLaser();
				//Creamos un laser
				_x=GetX()+GetWidth()/2-10;
				_y=GetY()-50;
				game.CreateLaser(_x,_Y,"normal");
			} 
		}
		//Si se pulsa la tecla n
		if(GetApp().pad.IsButtonDown(PAD_BUTTON_2)){
			//game.app.log("Bomba lanzada");
			if(counter_bombs>0){
				counter_bombs--;
				//Creamos un flash
				_flash=GetApp().NewObject("flash","Flash",null, [game]);
				game.delete_objects(false);
				game.draw_HUD();
			}
		//Si se pulsa la tecla d
		}else if(GetApp().pad.IsButtonDown(PAD_BUTTON_3)){
			create_shield();
		// pulsando la tecla tab pasamos de pantalla
		}else if(GetApp().pad.IsButtonDown(PAD_BUTTON_4)){
			game.ChangeLevel();
		//Con la tecla Esc salimos del juego
		}else if(GetApp().pad.IsButtonDown(PAD_BUTTON_8)){
			GetApp().log("pulsada la tecla escape");
		//Con la tecla P pausamos el juego
		}else if(GetApp().pad.IsButtonDown(PAD_BUTTON_9)){
			GetApp().log("pulsada la tecla pausa");
			
			game.gamePaused=true;
		}

		incpos(_incrementoX,0);
		_x=clamp(GetX(),0, GetApp().BOARD_WIDTH-GetWidth());
		setX(_x);
	}
	function OnSpriteCollision(_self, _spr){
		//GetApp().Log("colision player con "+Class_Id(_spr));
        if(Class_Id(_spr)=="Capsule"){
			//Dependiendo del tipo de capsula hacemos una cosa u otra
			switch(_spr.type){
				case "live":
					lives++;
				break;
				case "3ball":
					type="3ball";
					for(i=0;i<2;i++) {
						_ball=game.create_ball(i+1);
					}
				break;
				case "largue":
					if(!timer_is_actuve) {
						type="largue";
						timer_is_actuve=true;
						timer_return_normal=NewObject("timer", "GL_Timer");
						timer_return_normal.SetFrequency(1000);
						timer_return_normal.SetUserCallBack(this,"OnTimerResturNormal");
						SetSize(160,20, true);
						SetCollisionRect(0,0,160,20);	
					}
				break;
				case "laser":
					if(!timer_is_actuve) {
						type="laser";
						timer_is_actuve=true;
						timer_return_normal=NewObject("timer", "GL_Timer");
						timer_return_normal.SetFrequency(1000);
						timer_return_normal.SetUserCallBack(this,"OnTimerResturNormal");
						SetAnimation("laser");
					}
				break;
				case "bomb":
					counter_bombs++;
				break;
				case "clock":
					game.ball.speed=1;
				break;
				case "shield":
					shields++;
					create_shield();
				break;
				case "next":
					game.ChangeLevel();
				break;
			}
			_spr.Destroy();
			_fx=CreateFX("TINT");
			_fx.Start(1000, RGB(255,255,255));
			game.draw_HUD();
		}else if(Class_Id(_spr)=="Brick" ){
			_spr.SetPos(-100,-100);
			game.delete_brick(_spr);
			game.player_die();
			return;
		} 
		else if(Class_Id(_spr)=="Rock" || Class_Id(_spr)=="Enemy"){
			_spr.Destroy();
			game.player_die();
		}
	}
	function create_shield(){
		if(!timer_is_actuve && shields>0) {
			type="shield";
			shields--;
			SetAnimation("shield");
			timer_is_actuve=true;
			timer_return_normal=NewObject("timer", "GL_Timer");
			timer_return_normal.SetFrequency(1000);
			timer_return_normal.SetUserCallBack(this,"OnTimerResturNormal");
		}
	}

	function OnTimerResturNormal(_timer){
		game.draw_HUD();
		time_to_normal--;
		if(time_to_normal<=0){
			player_return_normal();
			//timer_return_normal=null;
			timer_is_actuve=false;
			time_to_normal=20;
			delete timer_return_normal;
		}
    }

	function player_return_normal(){
		SetSize(80,20, true);
		type="normal";
		SetCollisionRect(0,0,80,20);	
		SetColor(RGB(255,255,255));
		SetAnimation("normal");
		timer_is_actuve=false;
		time_to_normal=20;
		delete timer_return_normal;
	}
}