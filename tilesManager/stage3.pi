class Stage2 implements GL_Stage{
    properties:
        text=null;
        player=null;
        mapper=null;
        

    virtual _operator_new(_name,_creator){
        _background=newobject("fondo","gl_sprite");
		_background.Addframe("images/stage3.png");
        _background.SetPriority(-1);
        
        GetApp().stageGlobal.tilesManager.Load("level3.vgs");
        GetApp().stageGlobal.player.SetPos(100,GetApp().GetGl().GetResY()-64-64-64);
        GetApp().stageGlobal.draw_text();
    }


}
        