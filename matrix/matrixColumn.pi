namespace matrix_effect;

class MatrixColumn implements GL_Text
{
    properties:
        speed = 0.0f;
        timer = 0;
        charUpdateTimer = 0;
        colors=[]; 
        counter=0;
    // Constructor que recibe la posición inicial y velocidad
    virtual _operator_new(_name, _creator, _params)
    {
        // Configuramos la fuente bitmap o TTF [7, 8]
        SetFont("fonts/MonomaniacOne-Regular.ttf",12);
        //SetFontName("fonts/matrix.png"); 
        //SetFontSize(2, 2);
       
        colors+=[RGB(0, 255, 0)];
        colors+=[RGB(34, 137, 10)];
        colors+=[RGB(20, 76, 3)];
        colors+=[RGB(10, 36, 0)];

        // Color verde Matrix clásico [9, 10]
        SetColor(colors[3]); 
        
        // Parámetros iniciales: [x, y, speed] [11]
        SetPos(_params[0], _params[1]);
        speed = _params[2];
        
        // Generamos caracteres aleatorios iniciales [14]
        UpdateCharacters();
    }

    function UpdateCharacters()
    {
        _str = "";
        for(i=0;i<15;i++)
        {
            //_str += ascii(rand(33, 126)); // Caracteres ASCII aleatorios [16, 17]
            _str += ascii(rand(48, 49)); // Caracteres ASCII aleatorios [16, 17]
            _str += "\n"; // Salto de línea para crear la columna [18]
        }
        SetText(_str);
    }

    virtual Move()
    {
        counter++;
        // Movimiento vertical descendente usando el factor delta [19-21]
        IncPos(0, speed * GetFTime());

        // Si la columna sale por la parte inferior, vuelve arriba [22, 23]
        if (GetY() > GetApp().GetResY())
        {
            //SetY(-GetTextHeight()); // Reinicia por encima de la pantalla [23]
            SetY(-200); // Reinicia por encima de la pantalla [23]
            speed = frand(0.1, 0.5); // Cambia la velocidad aleatoriamente [14]
            
            _size=rand(8,12);
            if(_size==8)  SetColor(colors[3]); 
            else if(_size==9) SetColor(colors[3]); 
            else if(_size==10) SetColor(colors[2]); 
            else if(_size==11) SetColor(colors[1]); 
            else if(_size==12) SetColor(colors[0]); 
            SetFontSize(_size, _size);
        }

        // Actualizar caracteres cada cierto tiempo para el efecto dinámico [24, 25]
        if ((GetTime() - charUpdateTimer) > 100)
        {
            UpdateCharacters();
            charUpdateTimer = GetTime();
        }
    }
}