namespace es_tipolisto_WulfgarI;

/**
* Pantalla 7: el mapa 2
 */
class Stage7{
    properties:
        game=null;
        bg=null;

    function _operator_new(_game){
        game=_game;
        if (DEBUG_MODE) {
            _game.SetDebug(true);
            //_game.create_object(OBJECT_TYPE_META,200,_game.GetApp().GetResY()-100,game.currentStage);
        }
        _game.player1.SetVisible(false);
        _tmx = new TMX_tiles();
        _tmx.Load(_game.mapper,"resources/tilesmap7.tmx", _game);
        delete _tmx;
        //Colocamos el fondo
        bg=_game.NewObject("bg","gl_sprite");
        _texture=game.resources.get_bg_image(game.currentStage);
        bg.AddTexFrame(_texture);
        bg.SetPriority(-1);
       //Pintamos el marcador
        game.print_score();     
        //game.GetApp().Sleep(1000);   
        //game.GetEngine().LogPrint("map2 cargado");
    }
    function _operator_delete(){
        bg.Destroy();
        game.player1.SetVisible(true);
        game.delete_fires();
        delete game.layer;
    }   
}