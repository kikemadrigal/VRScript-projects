namespace es_tipolisto_WulfgarI;

/**
* 11 segundos
* Pantalla 8
* Fondo: Cueva de fuego
* Tiles: Ladrillos marrones y blancos.
* Enemigos 17: 
    Enemigo en una nube tirándote fuego, 
    monstruos tirando fuego en horizontal y vertical
* Objetos 16:
    Llaves, 
    candado, 
    monedas

*/
class Stage14{
    properties:
        game=null;
        bg=null;
        //timer_create_enemies=null;

    function _operator_new(_game){
        game=_game;
        if (DEBUG_MODE){
            _game.SetDebug(true);
            _game.create_object(OBJECT_TYPE_META,170,_game.GetApp().GetResY()-100, game.currentStage);
        }
        //game.GetEngine().LogPrint("Estamos en el stage 14");
        //ponemos que tenemos que coger 3 llaves
        _game.player1.keys_to_collect=3;
        _game.player1.SetPosition(20,_game.GROUND_Y);
        //Colocamos el fondo
        bg=_game.NewObject("bg","gl_sprite");
        bg.AddTexFrame(game.resources.get_bg_image(game.currentStage));
        bg.SetPriority(-1);
        // Dibujamos los tiles
        _tmx = new TMX_tiles();
        _tmx.Load(_game.mapper, "resources/tilesmap14.tmx", _game);
        delete _tmx;
        //pintamos el marcador
        _game.print_score();
    }
    function _operator_delete(){
        bg.Destroy();
        delete game.layer;
    }
}