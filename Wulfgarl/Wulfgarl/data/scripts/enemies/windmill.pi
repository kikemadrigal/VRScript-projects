namespace es_tipolisto_WulfgarI;
class Windmill implements Enemy{
    properties:
        angle=0;

    virtual _operator_new(_name,_creator, _params){
        Addanimationwithsheet("windmillBlades","images/objects-enemies.png",0,0,6*32,15*32,64,7*32,-1,-1,-1,.2);  
		Setanimation("windmillBlades");
        SetCollision(True);
        Setcollisionrect(0,0,64,7*32);
        //SetPivot(0, 1);
    }

    virtual Move(){
        angle += 0.05f;
        if(angle > 6.28f) angle = 0;
        SetAngle(angle);
    }
    
}