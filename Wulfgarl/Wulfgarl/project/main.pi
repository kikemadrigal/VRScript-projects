//namespace es_tipolisto_Wulfgarl;
 
 class main implements GL_Program partial myConstants{
    properties:
        stageGlobal=null;
    	menu=null;
        game=null;
        winner=null;
        records=null;
        camera_not_move=false;
        is_vertical_stage=false;
        fade_menu=null;
    
        db=null;
        lang=null;
        pause=false;
 
    function Init()
	{
        //if(sizeof(GetNumParams())>0)GetEngine().LogPrint("el parámetro es "+GetParam(0));
        //else GetEngine().LogPrint("no hay parámetros");
        _wnd = CreateWindow();
        _wnd.AddStyle(_wnd.STYLE_SHOW_FULLSCREEN);
		//_wnd.AddStyle(_wnd.STYLE_CLOSE_BOX);
		//_wnd.AddStyle(_wnd.STYLE_HIDE_MOUSE_CURSOR);
		_wnd.SetTitle("Wulfgar I [Build:" + string(APP_BUILD_VERSION) + "]");
        _wnd.AddHotKey([KEY_LCONTROL, KEY_Q], this, "OnFileExit");

		_menu = _wnd.CreateMenu();
		_section = _menu.AddSection ("File");
		_section.AddItem ("Exit", this, "OnFileExit");
    
		::Init();
	}
    function OnAddLink() {
        GetEngine().RunProgramWithParams("openurl.bat", []);
    }
	
	function OnFileExit(){
        stageGlobal.play_sound_click();
        Gl.Stop();
        pause=true;
        //AlertDialog (title, text, mode = 0, ctx = null, f1 ="OnAlertDialogOK", f2 = "OnAlertDialogCancel", f3 = "")
        GetEngine().AlertDialog("Warning",lang.get_value("quit_the_game"),View.AD_OKCANCEL,this,OnExitSuccess, OnExitCancel);
	}
    function OnExitSuccess(){
        End(0);
    }
    function OnExitCancel(){
        pause=false;
        Gl.Start();
    }

    virtual start(){
        //AddScriptPackage("scripts");
        AddScriptPackage("stages");
        AddScriptPackage("bosses");
        AddScriptPackage("enemies");
        Setbackcolor(RGB(0,0,0));
        Setresolution(VIEWPORT_WIDTH,VIEWPORT_HEIGHT);
        //Lo agrandamos solo en horizontal de 800 a 1280 que suele ser la resuloción habotual
        Setviewscale(-1);
        Setvsync(true);
        Setframerate(40);
        //la base de datos
		db=new Db(this);
        //Las frases internacionalizadas o localización
        lang=new language(this);

        //El stageGlobal es usado para los marcadores y elementos generales
        stageGlobal=newStage("stageGlobal","StageGlobal");
        fade_menu = NewStage("fade", "fade");
        changeMenuScreen();
    }

    function set_vertical_stage(value){
        is_vertical_stage=value;
    }
    function SetCameraNotMove(value){
        camera_not_move=value;
    }

    function CenterCamera(_player1){
        if(is_vertical_stage){
            _y_camera=_player1.GetY()-VIEWPORT_HEIGHT/2;
            _y_camera=Clamp(_y_camera,0, 3000-VIEWPORT_HEIGHT);
            game.SetCameraY(_y_camera);
        }else{
            _x_camera=_player1.GetX()-GetResX()/2;
            _x_camera=Clamp(_x_camera,0, LEVEL_WIDTH-GetResX());
            game.SetCameraX(_x_camera);
        }
        
    }
    function changeWinnerScreen(){
         stageGlobal.text_boss_live.SetText("");
        stageGlobal.play_sound_click();
        if(game!=null)delete game;
        RunStage("winner", "Winner");
        _change ("winner");
        StageGlobal.play_music_winner();
    }

    function changeMenuScreen(){
        gl.Stop();
        menu=RunStage("menu","Menu");
        _change ("menu");
        gl.Play();
        StageGlobal.play_music_menu();
        fade_menu.Off();
    }

    function change_records_screen(){
        records=RunStage("records","Records");
        _change ("records");
        fade_menu.Off();
    }

    function run_game(){
        //fade_menu.Off();
        if(winner!=null) delete winner;
        if(menu!=null) delete menu;
        gl.Stop();
        //if(game!=null) delete game;
        game=RunStage("game","Game");
        _change ("game"); 
        gl.Play();
       
    }

    state "menu":
    {
        if(stageGlobal.pad.IsButtonDown(PAD_BUTTON_1)){ 	
            stageGlobal.play_sound_click();
            StageGlobal.stop_music_winner();
            menu.text.SetText("");
            for (i = 255; i > 0; i--) {
                GetEngine().Sleep(1);
                menu.background.SetAlpha(i);
                menu.mosaico.SetAlpha(i);
            }
            menu.background.SetAnimation("map1");
            menu.background.SetAlpha(255);
            fade_menu.SetOnCompleted(this,"run_game");
            //fade_menu.On();
        }
        //Al pulsar la tecla R vamos al menú de records
        else if(stageGlobal.pad.IsButtonDown(PAD_BUTTON_4)){ 	
            stageGlobal.play_sound_click();
            fade_menu.SetOnCompleted(this,"change_records_screen");
            fade_menu.On();
        }
    }




    state "records":
    {
        //Si se pulsa espacio volvemos al menú
        if(stageGlobal.pad.IsButtonDown(PAD_BUTTON_1)){ 	
            fade_menu.SetOnCompleted(this,"changeMenuScreen");
            fade_menu.On();
        //Si se pulsa la tecla s se envia el score
        }else if(stageGlobal.pad.IsButtonDown(PAD_BUTTON_5)){
			send_score();
        //Si se pulsa la tecla n se asigna un nombre
		}else if(stageGlobal.pad.IsButtonDown(PAD_BUTTON_7)){
            _textModal="Escribe tu nombre";
            _name_user="";
            do{
                _name_user=GetEngine().InputDialogModal(_textModal,"",View.AD_OK,"");
                _textModal="El nombre no puede estar vacío ni ser menor de 4 caracteres";
            }while(_name_user=="" || strlen(_name_user)<=3);
			db.UpdateUser(_name_user);
            fade_menu.SetOnCompleted(this,"changeMenuScreen");
            fade_menu.On();
        //Si se pulsa la tecla d se reinician los scores
		}else if(stageGlobal.pad.IsButtonDown(PAD_BUTTON_6)){
            _res=GetEngine().InputDialogModal("Escribe Si para resetar la base de datos","",View.AD_OK,"");
            if(_res=="Si"){
                db.reset_records();
                fade_menu.SetOnCompleted(this,"changeMenuScreen");
                fade_menu.On();
            }
        }
    }




    state "game":
    {
        if(pause) return;
        if(DEBUG_MODE) game.print_score();
        _player1=game.player1;
        _player1.incrementoX=0;


        /**
         * Gestor de pulsaciones de teclas
         */
        //Si se pulsa el cursor derecho
        if (stageGlobal.pad.IsButton(PAD_BUTTON_RIGHT)){
            tile_right=game.get_tile_64_px(TILE_POSITION_RIGHT,_player1.GetX(),_player1.GetY());
            if(tile_right>TILE_TYPE_GROUND || tile_right==TILE_TYPE_EMPTY  ) _player1.incrementoX=_player1.speedX;	
            _player1.SetHFlip(False);	
            if(!camera_not_move)CenterCamera(_player1);
        }else if (stageGlobal.pad.IsButton(PAD_BUTTON_LEFT)){
            tile_left=game.get_tile_64_px(TILE_POSITION_LEFT,_player1.GetX(),_player1.GetY());
            //Solo se moverá es si el tile es mayor que el último de los tíles sólidos
            if(tile_left>TILE_TYPE_GROUND || tile_left==TILE_TYPE_EMPTY  ) _player1.incrementoX=-_player1.speedX;	
            _player1.SetHFlip(True);
            if(!camera_not_move)CenterCamera(_player1);
        }

    
        // Agarrar un paquete de paja
        if(stageGlobal.pad.IsButton(PAD_BUTTON_2)){
            _player1.pick=true;
            _player1.SetAnimation("pick");
        }
        
         // Si se pulsa arriba y no estamos ya saltando
        if(stageGlobal.pad.IsButton(PAD_BUTTON_UP) && _player1.aceleracion==0){
            stageGlobal.play_sound_jump();
            //Si en el tile de abajo es un muelle
            if(game.get_tile_64_px(TILE_POSITION_DOWN,_player1.GetX(),_player1.GetY())==TILE_TYPE_BOUNCY) _player1.incrementoY=-10;
            else _player1.incrementoY=-5;
            _player1.aceleracion=0;
        }

        if(stageGlobal.pad.IsButton(PAD_BUTTON_DOWN) && _player1.aceleracion==0){
            _player1.SetAnimation("crouching");
            _player1.crouching=true;
        }
        if(stageGlobal.pad.IsButtonUp(PAD_BUTTON_DOWN)){
            _player1.crouching=false;
            _player1.SetAnimation("idle");
        }
        
        //Fíjate que el isButtonDown solo devuelve verdadero una vez
        if(stageGlobal.pad.IsButtonDown(PAD_BUTTON_1)){
            
            stageGlobal.play_sound_atack();
            _player1.attack=true;  
            _player1.SetAnimation("attack");
            //Fijate que el newObject del GL_Program es distinto al del GL_Stage
            //La vara se elimina sola al medio segundo
            vara=NewObject("vara","Vara",null,[_player1, game]);
            /*
                TODO: ¿Como se borran los tiles?
            */
            // Si hay un bloque destructible a la derecha, lo borramos del tileset
            /*if(game.get_tile_64_px(TILE_POSITION_CENTER,_player1.GetX(),_player1.GetY())<=TILE_TYPE_SAND && game.get_tile_64_px(TILE_POSITION_CENTER,_player1.GetX(),_player1.GetY())>TILE_TYPE_GROUND){
                //game.set_tile(_player1.GetX(),_player1.GetY(),TILE_TYPE_EMPTY);
            }*/
        }
        _x=clamp(_player1.GetX(),0, LEVEL_WIDTH-_player1.GetWF());
        if(!is_vertical_stage)
            _y=clamp(_player1.GetY(),0, LEVEL_HEIGHT-_player1.GetHF());
        else
            _y=clamp(_player1.GetY(),0, 3000-_player1.GetHF());
        _player1.SetPos(_x,_y);
        _player1.incpos(_player1.incrementoX,_player1.incrementoY);



        /**
         * Gestor de animaciones
         */
        //Si el player está atacando
        if(_player1.attack){
            if(_player1.GetAnimationLoops()>0) _player1.attack=false;  
        }else if(_player1.pick){
            if(_player1.GetAnimationLoops()>0) _player1.pick=false;  
        }else{  
            if(_player1.aceleracion!=0){ 
                if(camera_not_move && game.currentStage==5)CenterCamera(_player1);
                //Si está subiendo	
                if (_player1.incrementoY<0 && _player1.GetY()>0){ 
                    _player1.Setanimation("jump");
                    //Chequeamos que no haya un tile sólido encima y que no sea la parte superior de la pantalla
                    _tile_up=game.get_tile_64_px(TILE_POSITION_UP,_player1.GetX(),_player1.GetY());
                    if(_tile_up<TILE_TYPE_GROUND && _tile_up!=TILE_TYPE_EMPTY || _player1.GetY()<=0){
                        _player1.incrementoY=0;
                        _player1.aceleracion=0;
                    }
                }
                //Si está bajando
                else _player1.Setanimation("fall"); 
            }
            //Si se pulsa izquierda o derecha
            else if(_player1.incrementoX) _player1.Setanimation("walk");   
            //Si se pulsa el botón de agarrar
            else if(_player1.crouching) _player1.SetAnimation("crouching");	 
            // Si está caminando (la pantalla de correr se activa sola al movernos)
            else if(_player1.walking) _player1.SetAnimation("walk");	  
            else if(_player1.GetCurAnimation() !="idle") _player1.SetAnimation("idle");
        }


        //Rollo gravedad hasta el suelo		
        if(_player1.GetY()>=game.GROUND_Y){
            _player1.SetY(game.GROUND_Y);
            _player1.incrementoY=0;
            _player1.aceleracion=0;
        }else{
            //Rollo aceleración
            _player1.incrementoY+=_player1.aceleracion*GetFTime();
            if(_player1.aceleracion<0.3)_player1.aceleracion+=GetFTime()*0.025f;
        }
    }

    state "winner":
    {
        if(stageGlobal.pad.IsButtonDown(PAD_BUTTON_1)){
            stageGlobal.text_score.SetText("");
            fade_menu.SetOnCompleted(this,"changeMenuScreen");
            fade_menu.On();
        }
    }


    function send_score(){
         Log("enviando score");
        _http=GetEngine().CreateHTTPManager();
        _name=db.GetUser();
        //mostramos un formaulario para que introduzca su nombre
        _score=db.get_max_player();
        //Hacemos la petición al servidor
        _ret=_http.GetString("https://games.tipolisto.es/api/wulfgar-savescore.php?score="+_score+"&name="+_name+"&game=wulfgar");
        //Log(_ret);
        stageGlobal.text_game.SetText("Server response: "+_ret);
        GetEngine().Sleep(2000);
        stageGlobal.text_game.SetText("");
        //stageGlobal.text_game.SetPos(100, 10);
        delete _http;
    }
}
   