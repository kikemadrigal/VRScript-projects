namespace es_tipolisto_WulfgarI;

/**
* Pantalla 1:el mapa
 */
class Stage1{
    properties:
        game=null;
        bg=null;
        mosaico=null;
        contador=0;
       // timer_create_load_resources=null;
    function _operator_new(_game){
        game=_game;
        if (DEBUG_MODE) {
            _game.SetDebug(true);
            //_game.create_object(OBJECT_TYPE_META,200,_game.GetApp().GetResY()-100,game.currentStage);
        }

        _game.player1.SetVisible(false);
        
        _tmx = new TMX_tiles();
        _tmx.Load(_game.mapper,"resources/tilesmap1.tmx", _game);
        delete _tmx;

        bg=_game.NewObject("bg","gl_sprite");
        _texture=game.resources.get_bg_image(game.currentStage);
        bg.AddTexFrame(_texture);
        bg.SetPriority(-1);

        



        //game.background_moving=true;

        //game.print_text_game("Loading backgrounds level 1");
        //game.resources.load_bgs(1);
        //game.print_text_game("Loading actors level 1");
        //game.resources.load_actors(1);
        //game.print_text_game("");
        //timer_create_load_resources=game.NewObject("timer", "GL_Timer");
        //timer_create_load_resources.SetFrequency(1000);
        //timer_create_load_resources.SetUserCallBack(this,"OnTimerLoadResourcesCallBack");
        //timer_create_load_resources.Start();
            
    }

    function _operator_delete(){
        game.player1.SetVisible(true);
        delete game.layer;
        bg.Destroy();
    }   

    /*function OnTimerLoadResourcesCallBack(){
        game.print_text_game("Loading backgrounds level 1");
        game.resources.load_bgs(1);
        game.print_text_game("Loading actors level 1");
        game.resources.load_actors(1);
        game.print_text_game("");
        timer_create_load_resources.Stop();
