        sql="insert into records (name, score, isMy, date) values ('"+name_for_record+"', "+score+", 1,datetime('now','localtime'));";
        connection.Query(sql);
        GetEngine().LogPrint("INSERT HECHOs");
            

        
        GetEngine().CloseDB(connection);
  
    }
