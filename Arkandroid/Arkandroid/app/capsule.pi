namespace es_tipolisto_arkandroid;
		/**
		 *      live, vida extra
				laser, permite disparar para romper rocas
				3ball, genera 3 bolas
				largue, aumenta el tamaño de tu nave
				next, permite pasar de panatañña
				bomb: ve recargando para eliminar objetos en la pantalla, pulsa la n
				clock: que pone la bola más lenta
				shield: escudo protector
		 */
class Capsule implements GL_sprite{
	properties:
		game=null;
		type="normal";

	virtual _operator_new(_name,_creator,_params){
		game=_params[0];
		type=_params[1];
		SetVisible(false);
		SetStop(true);
		SetCollision(false);		
		SetType(PRIORITY_CAPSULE);
        SetPriority(PRIORITY_CAPSULE);
		switch(type){
			case "live":{
				Addanimationwithsheet("live","res/capsules.png",0,0,40*0,20*0,40,20);
				setAnimation("live");
				break;
			}
			case "laser":{
				Addanimationwithsheet("laser","res/capsules.png",0,0,40*1,20*0,40,20);
				setAnimation("laser");
				break;
			}
			case "3ball":{
				Addanimationwithsheet("3ball","res/capsules.png",0,0,40*2,20*0,40,20);
				setAnimation("3ball");
				break;	
			}
			case "largue":{
				Addanimationwithsheet("largue","res/capsules.png",0,0,40*3,20*0,40,20);
				setAnimation("largue");
				break;	
			}
			case "next":{
				Addanimationwithsheet("next","res/capsules.png",0,0,40*4,20*0,40,20);
				setAnimation("next");
				break;	
			}
			case "bomb":{
				Addanimationwithsheet("bomb","res/capsules.png",0,0,40*5,20*0,40,20);
				setAnimation("bomb");
				break;	
			}
			case "clock":{
				Addanimationwithsheet("clock","res/capsules.png",0,0,40*6,20*0,40,20);
				setAnimation("clock");
				break;	
			}
			case "shield":{
				Addanimationwithsheet("shield","res/capsules.png",0,0,40*7,20*0,40,20);
				setAnimation("shield");
				break;	
			}
		}
	}
	virtual Move(){
		incpos(0,2);
		if(GetY()>GetApp().BOARD_HEIGHT)game.delete_capsule(this);
	}
}