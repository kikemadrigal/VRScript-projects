namespace es_tipolisto_arkandroid;

class winner implements App{
	properties:
		text=null;
		bg=null;
	
	virtual _operator_new(_app){
		_bg=app.NewObject("image","GL_Sprite");
		_bg.addframe("res/winner.png");
		_bg.SetSize(800,450);
		bg=_bg;

		_record_user=0;
		_record_user=app.db.get_max_player();
	

		_text=app.NewObject("text","GL_Text");
		_text.SetFont("fonts/matrix.ttf", 24);
		_text.SetText("Score: "+_record_user);
		_text.SetPos(app.GetResX()/2-_text.GetTextWidth()/2-100,300);
		text=_text;
	}
	
	virtual _operator_delete(){
		app.Log("borrando el winner");
	 	delete text;
		delete bg;
	}
}