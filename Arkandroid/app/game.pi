namespace es_tipolisto_arkandroid;

class Game implements App{
/**
 * Los tablerso del juego es una matriz de rocas
 * cada uno de los elementos de la matriz es un string que representa el tipo de ladrillo
 * por otro lado creamos una matriz tridimensional que representa la fase con los 6 niveles
 */
	properties:
		level=0; 	//1 fase
		//level=5;  //2 fase
		//level=11; //3 fase
		//level=18; //4 fase

		text_hud=null;
		player=null;
		ball=null;
		active_phase = dim([24, 11, 11], null);
		rocks=[];
		indestructible_rocks=[];
		balls=[];
		capsules=[];
		meteorites=[];
		rock_falls=[];
		enemies=[];
		lasers=[];
		bosses=[];
		boss_active=null;
		board_bg=null;
		board_ornament=null;
		ornament_hud=null;
		capsules_type=["3Ball","laser","live","largue","laser","bomb","clock","shield"];
		//capsules_type=["laser","laser","laser","laser","laser","laser","laser","laser"];
	
		timer_game=null;
		timer_change_level=null;
		time=0;
		mode_boss=false;
		arrow=null;
		//laser_template=null;
		barFondo=null;
		barProgreso=null;
	/**
	 * Construcor
	 * 
	 * Aquí inicializamos los elementos del juego
	 * 
	 * @param _app
	*/
	virtual _operator_new(_app){
		//Adorno marcador
		_ornament_hud=app.NewObject("ornament_hud","GL_Sprite");
		_ornament_hud.AddFrame("res/ornament-hud.png");
		_ornament_hud.SetPos(app.BOARD_WIDTH,0);
		_ornament_hud.SetPriority(app.PRIORITY_BG);
		ornament_hud=_ornament_hud;
		//Flecha que sale a la derecha marcando los planetas
		_arrow=app.NewObject("arrow","GL_Sprite");
		_arrow.AddFrame("res/arrow.png");
		_arrow.SetPos(680,32);
		_arrow.SetPriority(app.PRIORITY_BG);
		_arrow.SetSize(30,30, true);
		arrow=_arrow;
		//Fondo del juego
		_board_bg=app.NewObject("board_bg","GL_Sprite");
		_board_bg.AddFrame("res/level1.png");
		_board_bg.SetPriority(app.PRIORITY_BG);
		board_bg=_board_bg;
		//Contorno del juego
		_board_ornament=app.NewObject("board_ornament","GL_Sprite");
		_board_ornament.AddFrame("res/ornament-level.png");
		_board_ornament.SetPriority(app.PRIORITY_BG);
		board_ornament=_board_ornament;

		//El marcador con las vidas y la puntuciÃ³n
		_text_hud=app.NewObject("text","GL_Text");
		_text_hud.SetFont("fonts/matrix.ttf", 12);
		_text_hud.SetColor(RGB(255,255,0));
		_text_hud.SetPos(app.BOARD_WIDTH+20,20);
		text_hud=_text_hud;

		// 1. Crear el fondo de la barra (el marco)
        barFondo = app.NewObject("pbar_bg", "gl_sprite");
        barFondo.AddEmptyFrame(200, 20);
        barFondo.SetColor(RGB(255, 255, 0)); 
        barFondo.SetPos(app.BOARD_WIDTH/2-50, app.GetResY()-220);
        barFondo.SetPriority(PRIORITY_PROGRESS_BAR_MASK); 
		//barFondo.SetVisible(true);
		barFondo.SetWidth(100);

        // 2. Crear la barra de progreso (la que indica la carga)
        // Se hace un poco más pequeña para que quepa dentro del fondo
        barProgreso = app.NewObject("pbar_status", "gl_sprite");
        barProgreso.AddEmptyFrame(10 - 4, 20 - 4);
        barProgreso.SetColor(RGB(255, 0, 0)); // Color blanco para el estado
        barProgreso.SetPos(barFondo.GetX() + 2, barFondo.GetY() + 2);
        barProgreso.SetPriority(PRIORITY_PROGRESS_BAR);
		//barProgreso.SetVisible(true);

		//Player 1
		_player=app.NewObject("player", "Player", null, [this, app.BOARD_WIDTH/2, app.GetResY()-100, False]);
		player=_player;

		//Creamos la bola
		//_ball=app.NewObject("ball","Ball",null,[this, app.BOARD_WIDTH/2, app.GetResY()/2]);
		_ball=app.NewObject("ball","Ball",null,[this]);
		_ball.SetStop(false);
		_ball.SetCollision(true);
		ball=_ball;

		//El timer game nos sirve para llevar un contador de tiempo
		timer_game=app.NewObject("timer", "GL_Timer");
		timer_game.SetFrequency(8000);
		timer_game.SetUserCallBack(this,"OnTimerGame");
		
		/*timer_change_level=app.NewObject("timer_nextlevel","GL_Timer");
		timer_change_level.SetFrequency(8000);
		timer_change_level.SetUserCallBack(this,"OnTimerChangeLevel");*/

		//Ponemos el marcador
		text_hud.SetVisible(True);

		//Ponemos la música
		app.resources.PlaySoundGameStart();

		//Mostramos los mensajes e inicializamos las entidades
		app.text_game.SetText("Loading capsules");
		app.Sleep(1);
		//Creamos 10 capsulas
		for(_i=0;_i<5;_i++){
			_capsule_type=capsules_type[Rand(0,sizeof(capsules_type)-1)];
			_capsule=app.NewObject("capsule","Capsule",null, [this, _capsule_type]);
			capsules+=[_capsule];
		}
		barProgreso.SetWidth(2);
		app.text_game.SetText("Loading lasers");
		app.Sleep(1);
		//creamos 10 lasers
		for(_i=0;_i<5;_i++){
			_laser=app.NewObject("laser","Laser",null, [this]);
			lasers+=[_laser];
		}
		// 1. Creamos el objeto que servirá de molde
        //laser_template = app.GetActiveStage().NewObject("laser_temp", "Laser");
		//laser_template.CreateInstancesPool(10);
		//Creamos los rockfalls
		barProgreso.SetWidth(4);
		app.text_game.SetText("Loading Rock falls");
		app.Sleep(1);
		for(_i=0;_i<10;_i++){
			_rockfall=app.NewObject("rockfall","Rockfall",null, [this,"af"]);
			rock_falls+=[_rockfall];
		}
		barProgreso.SetWidth(6);
		//creamos las 6 bolas
		app.text_game.SetText("Loading extra balls");
		app.Sleep(1);
		for(_i=0;_i<6;_i++){
			_ball=app.NewObject("ball"+_i,"Ball",null,[this]);
			_ball.multiball=true;
			_ball.incposY=-4;
			balls+=[_ball];
		}
		barProgreso.SetWidth(8);
		app.text_game.SetText("Loading enemies");
		app.Sleep(1);
		//Cremoas 10 Enemigos
		for(_i=0;_i<10;_i++){
			_enemy=app.NewObject("enemy"+_i,"Enemy",null,[this]);
			enemies+=[_enemy];
		}
		barProgreso.SetWidth(9);
		app.text_game.SetText("Loading asteroids");
		app.Sleep(1);
		//Creamos 10 meteoritos
		for(_i=0;_i<10;_i++){
			_meteor=app.NewObject("Meteor"+_i,"Meteor",null,[this]);
			meteorites+=[_meteor];
		}
		barProgreso.SetWidth(10);
		app.text_game.SetText("Loading bosses");
		app.Sleep(1);
		//Cargamos los bosses
		for(_i=1;_i<5;_i++){
			//_name_boss="Boss"+String(_i);
			_boss=app.NewObject("boss"+_i,"Boss",null,[this]);
			_boss.create_type(_i);
			bosses+=[_boss];
		}

		//Pintamos el nivel
		change_level();
	}
	virtual Start(){
		timer_game.Stop();
		//timer_change_level.Stop();
	}
	
	/**
	 * Destructor
	 * 
	 * @method _operator_delete
	 */
	virtual _operator_delete(){
		app.Log("Borrando game");
		delete_objects();
		delete text_hud;
		delete board_bg;
		delete board_ornament;
		delete ornament_hud;
		delete arrow;
		delete player;
		delete ball;
		delete arrow_positions;
		timer_game.Stop();
		delete timer_game;
	}

	/**
	 * Función que dibuja el HUD
	 * 
	 * @method draw_HUD
	 */
	function draw_HUD(){
		_message="Screen: "+level;
		_message="\nHighscore:  \n"+player.high_score+"\nScore: \n"+player.score+"\nLives:  \n"+player.lives;
		_message+="\nBall speed: "+ball.speed;
		_message+="\nrocks: "+sizeof(rocks);
		//_message+="\nIdestructible_rocks: "+sizeof(indestructible_rocks);
		if(player.timer_is_actuve) _message+="\nPower-up: "+player.type+": "+player.time_to_normal;
		else _message+="\nPower-up: None";
		_message+="\nBombs: "+player.counter_bombs+", pulsa Ctrl para usarla";
		_message+="\nEscudos: "+player.shields+", pulsa Shift para usarlos";
		//_message+="\nFrequency: "+GetFPS()+" Ftime: "+GetFTime();
		//_message+="\nball incX: "+ball.incposX+" incY: "+ball.incposY;
		//_message+="\ntime: "+time;
		//_message+="\nplayer x: "+player.GetX()+", y: "+player.GetY();
		//_message+="\nBall speed: "+ball.speed+" incX: "+ball.incposX+" incY: "+ball.incposY;
		//_message+="\nNum lasers: "+sizeof(lasers);
		//_message+="\nNum enemies: "+sizeof(enemies);
		//_message+="\nRocks: "+sizeof(rocks);
		//_message+="\nCapsules: "+sizeof(capsules);
		//_message+="\nBalls: "+sizeof(balls);
		//_message+="\Meteorites: "+sizeof(meteorites);
		if(mode_boss) _message+="\nBoss life: "+boss_active.boss_live;
		_message+="\nMission: "+missions[level-1];
		
		text_hud.SetText(_message);
	}



	/**
	 * Función que se ejecuta cada vez que pasa un segundo
	 * 
	 * @method OnTimerGame
	 * 
	 * @param _timer
	 * 
	 */
	function OnTimerGame(_timer){
		time++;
		//app.Log("timer_game: "+time);
		if(time==10 && !mode_boss)capsules_type+=["next"];
		
		draw_HUD();
		//cada 10 segundos aumnentamos la velocidad de la bola
		if(time%10==0 && ball.speed<4){
			ball.speed+=0.5;
		}
		if(level>=0 && level<12){
			//if(!exist_enemies())create_enemy(rand(0,3));
			//if(!exist_enemies())create_enemy(4);
		}
		if(level>6 && level<12) create_meteor();
		else if(level>12 && level<18){
			if(!exist_enemies())create_enemy(4);
		}else if(level>18 && level<24){
			if(!exist_enemies())create_enemy(rand(0,3));
		}
	}
