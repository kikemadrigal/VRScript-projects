namespace es_tipolisto_arkandroid;

class Ball implements GL_sprite{
	properties:
		game=null;
		speed=0;
        initial_speed=2;
        multiball=false;
        incposX=0;
        incposY=0;

	virtual _operator_new(_name,_creator,_params){
		game=_params[0];
		//_x=_params[1];
		//_y=_params[2];
		speed=initial_speed;
        Addanimationwithsheet("ball","res/ball.png",0,11,0,0,20,20,-1,-1,-1,0.1);
        SetAnimation("ball");	
		//SetPos(_x,_y);	
        SetVisible(false);
		SetStop(true);
		SetCollision(false);
		Setcollidermode(true);
        SetType(PRIORITY_BALL);
        SetPriority(PRIORITY_BALL);
	    incposY=speed;
	}
	virtual Move(){
        /*if( incposX != 0){
            incposX=speed+GetFTime()*0.025f;
		    incposY=speed+GetFTime()*0.025f;
        }*/

		//Control mde bordes del juego
		if (GetX() <=20 ) {
            incposX =-incposX; 
            SetX(21);
            GetApp().resources.PlaySoundHit();
        }else if(GetX()+GetWF() > GetApp().BOARD_WIDTH-20) {
            incposX =-incposX;
            SetX(GetApp().BOARD_WIDTH-GetWF()-21);
            GetApp().resources.PlaySoundHit();
        }
		else if (GetY() <= 20) {
            incposY =-incposY;
            SetY(21);
            GetApp().resources.PlaySoundHit();
        }
        else{
            if(multiball && GetY() > GetApp().BOARD_HEIGHT) {
                //Si multiball es verdadero y la pelota se sale por abajo, la destruimos
                //game.balls-=[this];
                //Destroy();
                SetVisible(false);
                SetStop(true);
                SetCollision(false);
                SetPos(-100,-100);
                return;
            }
            else if(GetY() > GetApp().BOARD_HEIGHT) {
                game.player_die();
            }
        }       
		incpos(incposX,incposY);
	}

	function OnSpriteCollision(_ball, _spr){
        // GetEngine().logPrint("Colision con "+Class_Id(_spr));
        if(Class_Id(_spr)=="Player") GetApp().resources.PlaySoundHit();
      
       
        _colY=False;
        /*if(Class_Id(_spr)=="Capsule" || 
            Class_Id(_spr)=="Ball" || 
            Class_Id(_spr)=="Laser")return;*/

        if(_spr.Gettype()==PRIORITY_CAPSULE || 
           _spr.Gettype()==PRIORITY_BALL || 
           _spr.Gettype()==PRIORITY_LASER)return;
        if(_spr.Gettype()==PRIORITY_ENEMY){
            game.delete_enemy(_spr);
            return;
        }
        if(_spr.Gettype()==PRIORITY_METEOR){
            game.delete_meteor(_spr);
            return;
        }
        if(_spr.Gettype()==PRIORITY_BOSS){
            game.boss_active.boss_live--;
            GetApp().resources.PlaySoundHitBoss();
            _fx= game.boss_active.CreateFX("TINT");
			_fx.Start(1000, RGB(255,0,0));
            game.draw_HUD();
        }
   
       
        //Si la colsión es el player o la pala
        //Comprobamos si colisionamos por abajo
        
        if(GetY()>=_spr.GetY())
        {
            //Si La pelota toca la paleta por abajo, la situamos abajo
            //SetY(_spr.GetY()+_spr.GetHF());
            //La pelota rebota
            _colY=True;
			_message="colision por abajo";
            //Vamos a mirar el lugar de rebote en horizontal
            _zone=(GetXF()+GetWF()*0.5f) - _spr.GetXF();
            //En funciÃ³n de donde ha tocado la pelota en la paleta
            _zone=clamp(_zone / _spr.GetWF(),0,1);
            //incPosX=_zone-0.2f;
            incPosX=(_zone-0.5f)*speed;
            if(GetY()>21)incposY=speed;
        }else if(GetY()<_spr.GetY())
        {
            //Si La pelota toca la paleta por arriba, la situamos arriba
            //SetY(_spr.GetY()-GetHF()-1);
            //La pelota rebota
            _colY=True;
			_message="colision por arriba";
            //Vamos a mirar el lugar de rebote en horizontal
            _zone=(GetXF()+GetWF()*0.5f) - _spr.GetXF();
            //En funciÃ³n de donde ha tocado la pelota en la paleta
            _zone=clamp(_zone / _spr.GetWF(),0,1);
            //incPosX=_zone-0.2f;
            incPosX=(_zone-0.5f)*speed;
           if(GetY()>21) incposY=-speed;

        }      


		if(_spr.Gettype()==PRIORITY_ROCK){
             //GetEngine().logPrint("Colision con rock "+_spr.type);
             _spr.hits_died--;
             if(game.level==3){
                game.CreateCapsule(_spr.GetX(),_spr.GetY(), false);
             }else if(_spr.type!="i1" && _spr.type!="i2" && _spr.type!="i3" && _spr.type!="i4"){
                 GetApp().resources.PlaySoundHit();
                //GetEngine().logPrint("Vamos a crear una capsula");
                game.create_capsule(_spr.GetX(),_spr.GetY());
             }
           
            //di el tipo es dinamita
            if(_spr.type=="f" ){
                _flash=GetApp().NewObject("flash","Flash",null, [game]);
                game.delete_rock(_spr);
            //Si es el reloj para ralentizar la bola
            }else  if(_spr.type=="j" ){
                game.ball.speed=3;
                game.delete_rock(_spr);
            //Si es una bomba para recargar
            }else if(_spr.type=="ab" || _spr.type=="gb" || _spr.type=="mb" || _spr.type=="rb" || _spr.type=="vb" || _spr.type=="zb" || _spr.type=="ob"){
                game.player.counter_bombs++;
                //Obtenemos la primera letra del string para saber el color de la bomba
                _firstLetter = String_SubStr(_spr.type, 0, 1);
                //GetApp().Log("Bomba de color "+_firstLetter);
                //Borramos todos los rocks del mismo color
                for(i=0;i<sizeof(game.rocks);i++){
                    _rock=game.rocks[i];
                    if(_rock.type==_firstLetter){
                        game.delete_rock(_rock);
                        game.player.score+=50;
                    }
                }
                game.delete_rock(_spr);
            }else if(_spr.type=="af" || _spr.type=="gf" || _spr.type=="mf" || _spr.type=="rf" || _spr.type=="vf" || _spr.type=="zf" || _spr.type=="of"){
                //game.createLaser(_spr.GetX()+20, _spr.GetY()+_spr.GetHeight()+10, "enemy");
                game.delete_rock(_spr);
                game.Create_rock_fall(_spr.GetX(), _spr.GetY(),_spr.type );
            }else if(_spr.type=="d" ){
                //GetApp().log("Dinamita explotada");
                //borramos todos los rocks alrededor
                for(i=0;i<sizeof(game.rocks);i++){
                    _rock=game.rocks[i];
                   // GetApp().log(_rock.type);
                    if(_rock.type=="z"|| _rock.type=="a"|| _rock.type=="m"){
                        if(	_rock.GetX()>=_spr.GetX()-_spr.GetWF() && 
                            _rock.GetX()<=_spr.GetX()+_spr.GetWF() &&
                            _rock.GetY()>=_spr.GetY()-_spr.GetHF() &&
                            _rock.GetY()<=_spr.GetY()+_spr.GetHF()){
                                game.delete_rock(_rock);
                                game.player.score+=50;
                        }
                    }
                }
                //borramos el enemigo
                game.delete_rock(_spr);
                game.player.score+=50;
            }
            else if(_spr.type!="d" && _spr.hits_died==0 && !_spr.indestructible && sizeof(game.rocks)>0){
                //borramos el enemigo
                game.delete_rock(_spr);
                game.player.score+=50;
            }else{
                GetApp().resources.PlaySoundHit2();
                _fx=_spr.CreateFX("TINT");
                _fx.Start(1000, RGB(255,255,255));
                game.player.score+=10;
            }
           
        }else if(_spr.Gettype()==PRIORITY_ROCKFALL){
            game.delete_rock_fall(_spr);
            game.player.score+=50;
        }
        //GetEngine().LogPrint("colision "+_message+" incX:"+incPosX+" incY:"+incposY);
		game.draw_HUD();
   }
	

   function return_normal(){
     speed=initial_speed;
     incposY=speed;
     incPosX=0;
     //SetPos(GetApp().BoardWidth/2,GetApp().BoardHeight-100);
   }
	
	
}
