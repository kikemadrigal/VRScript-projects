	virtual _operator_new(_app){
		//Adorno marcador
		_ornament_hud=app.NewObject("ornament_hud","GL_Sprite");
		//_ornament_hud.AddFrame("res/ornament_hud.png",280,app.BOARD_HEIGHT);
		_ornament_hud.AddFrame("res/ornament-hud.png");
		_ornament_hud.SetPos(app.BOARD_WIDTH,0);
		_ornament_hud.SetPriority(app.PRIORITY_BG);
		ornament_hud=_ornament_hud;

		_board_bg=app.NewObject("board_bg","GL_Sprite");
		_board_bg.AddFrame("res/level1.png");
		_board_bg.SetPriority(app.PRIORITY_BG);
		board_bg=_board_bg;

		//El marcador con las vidas y la puntuciÃ³n
		_text_hud=app.NewObject("text","GL_Text");
		_text_hud.SetFont("fonts/Vintage Black.ttf", 16);
		_text_hud.SetColor(RGB(255,255,0));
		_text_hud.SetPos(app.BOARD_WIDTH+20,20);
		text_hud=_text_hud;

		//Player 1
		_player=app.NewObject("player", "Player", null, [this, app.BOARD_WIDTH/2, app.GetResY()-100, False]);
		_player.SetVisible(False);
		_player.SetPriority(APP.PRIORITY_PLAYER);
		_player.lives=5;
		_player.score=0;
		_player.SetPos(app.BOARD_WIDTH/2,app.GetResY()-40);
		_player.SetVisible(True);
		player=_player;

		//Creamos la bola
		_ball=app.NewObject("ball","Ball",null,[this, app.BOARD_WIDTH/2, app.GetResY()/2]);
		_ball.SetVisible(False);
		_ball.SetPriority(APP.PRIORITY_BALL);
		_ball.SetVisible(True);

		ball=_ball;

		//Ponemos el marcador
		text_hud.SetVisible(True);

		//Pintamos el nivel
		ChangeLevel();

		//El timer game nos sirve para llevar un contador de tiempo
		timer_game=app.NewObject("timer", "GL_Timer");
		timer_game.SetFrequency(3000);
		timer_game.SetUserCallBack(this,"OnTimerGame");
		timer_game.Stop();
		//Ponemos la música
		app.resources.PlaySoundGameStart();
	}
	
	


