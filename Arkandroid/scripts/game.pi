	function draw_HUD(){
		_message="Screen: "+level;
		_message="\nHighscore:  \n"+player.score+"\nScore: \n"+player.score+"\nLives:  \n"+player.lives;
		_message+="\nBall speed: "+ball.speed;
		_message+="\nBricks: "+sizeof(bricks);
		if(player.timer_is_actuve) _message+="\nPower-up: "+player.type+": "+player.time_to_normal;
		else _message+="\nPower-up: None";
		_message+="\nBombs: "+player.counter_bombs+", pulsa Ctrl para usarla";
		_message+="\nEscudos: "+player.shields;
		_message+="\nFrequency: "+GetFPS();
		//_message+="\ntime: "+time;
		//_message+="\nplayer x: "+player.GetX()+", y: "+player.GetY();
		//_message+="\nBall speed: "+ball.speed+" incX: "+ball.incposX+" incY: "+ball.incposY;
		//_message+="\nNum lasers: "+sizeof(lasers);
		//_message+="\nNum enemies: "+sizeof(enemies);
		//_message+="\nRocks: "+sizeof(rocks);
		_message+="\nMission: "+missions[level-1];
		if(mode_boss) _message+="\nBoss life: "+level_active.boss.boss_live;
		text_hud.SetText(_message);
		//show_map();
	}

	function OnTimerGame(_timer){
		time--;
		draw_HUD();
		//cada 10 segundos aumnentamos la velocidad de la bola
		if(time%10==0 && ball.speed<6){
			ball.speed+=0.5;
		}

		if(level>6 && level<12) {
			if(sizeof(rocks)==0)create_rock();
		}else if(level>12 && level<18){
			if(sizeof(enemies)==0)create_enemy(rand(0,3));
		}else if(level>18 && level<24){
			if(sizeof(enemies)==0)create_enemy(6);
		}
	}
	
	
	function ChangeLevel(){
		//app.log("Cambiamos al level "+level);
		if(level>0){
			app.text_game.SetText("level completed");
			app.GetEngine().sleep(2000);
			board_bg.RemoveFrames();
			_level_for_board=level+1;
			board_bg.AddFrame("res/level"+_level_for_board+".png");
		}

		timer_game.Stop();
		level++;
		delete_objects();
		if(level_active!=null) delete level_active;
	
		switch (level){
			case 1:
				//level_1();
				level_active=new Level1(this);
				break;
			case 2:
				//level_2();
				level_active=new Level2(this);
				break;
			case 3:
				level_active=new Level3(this);
				break;
			case 4:
				level_active=new Level4(this);
				break;
			case 5:
				level_active=new Level5(this);
				break;
			case 6:
				level_active=new Level6(this);
				break;
			case 7:
				level_active=new Level7(this);
				break;
			case 8:
				level_active=new Level8(this);
				break;
			case 9:
				level_active=new Level9(this);
				break;
			case 10:
				level_active=new Level10(this);
				break;
			case 11:
				level_active=new Level11(this);
				break;
			case 12:
				level_active=new Level12(this);
				break;
			case 13:
				level_active=new Level13(this);
				break;
			case 14:
				level_active=new Level14(this);
				break;
			case 15:
				level_active=new Level15(this);
				break;
			case 16:
				level_active=new Level16(this);
				break;
			case 17:
				level_active=new Level17(this);
				break;
			case 18:
				level_active=new Level18(this);
				break;
			case 19:
				level_active=new Level19(this);
				break;
			case 20:
				level_active=new Level20(this);
				break;
			case 21:
				level_active=new Level21(this);
				break;
			case 22:
				level_active=new Level22(this);
				break;
			case 23:
				app.Log("Vamos a pasar al level 23");
				level_active=new Level23(this);
				break;
			case 24:
				app.Log("Vamos a pasar al level 24");
				level_active=new Level24(this);
				break;
			case 25:
				app.Log("Vamos a pasar al stado game_over");
				app._change ("game_over");
				break;
			/*default:
				level=1;
				level_active=new Level1(this);
				break;*/
		}
		app.resources.PlaySoundGameStart();
		app.gamePaused=true;
		player.player_return_normal();
		app.resources.PlaySoundGameStart();
		app.gamePaused=true;
		player.player_return_normal();
		ball.ball_return_normal();
		draw_HUD();
	}



	
	function CreateBrick(_x,_y,_type){
		_brick=null;
		if (_type!=" " ){
			_brick=app.NewObject("brick","Brick",null, [this, _x*app.BRICK_WIDTH,_y*app.BRICK_HEIGHT, _type]);
			bricks+=[_brick];
		}		
		return _brick;
	}
	function CreateCapsule(_x,_y, with_probability=true){
		if(with_probability){
			_number_for_capsule=Rand(0,100);
			if(_number_for_capsule<20){
				_type=capsules_type[Rand(0,sizeof(capsules_type)-1)];
				_capsule=app.NewObject("capsule","Capsule",null, [this, _x,_y, _type]);
				capsules+=[_capsule];
			}
		}else{
			_type=capsules_type[Rand(0,sizeof(capsules_type)-1)];
			_capsule=app.NewObject("capsule","Capsule",null, [this, _x,_y, _type]);
			capsules+=[_capsule];
		}
	}
	function create_ball(_number_of_balls){
		_ball=app.NewObject("ball"+_number_of_balls,"Ball",null,[this, app.BOARD_WIDTH/2+(_number_of_balls*20), app.BOARD_HEIGHT/2]);
		_ball.SetVisible(True);
		_ball.SetColor(RGB(255,0,0));
		_ball.SetPriority(APP.PRIORITY_BALL);
		_ball.multiball=true;
		_ball.incposY=-4;
		balls+=[_ball];
		return _ball;
	}

	function create_enemy(_type=0){
		_enemy=app.NewObject("enemy"+Rand(0,1000),"Enemy",null,[this,_type]);
		enemies+=[_enemy];
		return _enemy;
	}

	function create_rock(){
		_rock=app.NewObject("rock"+Rand(0,1000),"Rock",null,[this, Rand(0, app.BOARD_WIDTH-76), 10]);
		rocks+=[_rock];
		return _rock;
	}

	function createLaser(_x,_y,_type){
		_laser=app.NewObject("laser","Laser",null,[this,_x, _y,_type]);
		lasers+=[_laser];
	}


	function player_die(){
		if(player.type=="shield") {
			player.player_return_normal();
			return;
		}
		player.lives--;
		delete_objects(false);
		timer_game.Stop();
		ball.SetPos(app.GetResX()/2,app.GetResY()/2);
		ball.ball_return_normal();
		player.player_return_normal();
		//Borramos el timer si existe
		if(player.timer_is_actuve) {
			delete player.timer_return_normal;
			player.timer_is_actuve=false;
		}
		//borramos las bolas extra si existen
		if(sizeof(balls)>0){
			for(i=0;i<sizeof(balls);i++){
				if(balls[i]!=ball) {
					delete balls[i];
					balls-=[balls[i]];
				}
			}
		}

		if(mode_boss){
			level_active.boss.SetPos(app.BOARD_WIDTH/2,40);
			app.gamePaused=true;
			level_active.boss.Stop();
		}
		
		if(player.lives<=0){
			delete_objects();
			app.resources.PlaySoundGameOver();
			app.text_game.SetText("Game Over");
			app.GetEngine().sleep(2000);
			if(app.db.CheckRecord(player.score)){
				app.gl.Stop();
				_textModal="Nuevo record!!!";
				do{
					name=app.GetEngine().InputDialogModal(_textModal,"",View.AD_OK,"");
					_textModal="El nombre no puede estar vacÃ­o ni ser menor de 4 caracteres";
				}while(name=="" || strlen(name)<=3);
				app.Log("El nombre introducido es "+name);
				app.db.InsertRecord(name,player.score);
				app.db.UpdateUserRecord(player.score);
				app.gl.Start();
				
			}
			player.score=0;
			player.lives=5;
			app.menu=new Menu(app);  
			app.gameOver=True;
			ball.speed=0;
			//ball.incPosX=0;
			ball.SetVisible(False);
			player.SetVisible(False);
			level=0;
			app._change("menu");
			
		}else{
			app.gamePaused=True;
		}
		draw_HUD();
	}

	function delete_enemy(_enemy){
		if(_enemy.touch_for_die==0){
			delete _enemy;
			enemies-=[_enemy];
		}else{
			_fx=_enemy.CreateFX("TINT");
			_fx.Start(1000, RGB(255,0,0));
			_enemy.touch_for_die--;
		}
	
	}
	function delete_brick(_brick){
		//Si 11 tile son 520 pixeles de ancho
		//    x            100pixeñes 
		//Borramos el brick del array del nivel
		//_tiles_in_rowx=app.BOARD_WIDTH/11;
		//_tiles_in_rowy=app.BOARD_HEIGHT/11;
		_tile_x=floor(_brick.GetX()/40);
		_tile_y=floor(_brick.GetY()/20);
		level_active.map[_tile_y+1][_tile_x-1]=" ";
	
		//app.Log("Borramos el brick: "+_tile_y+" "+_tile_x);
		//delete _brick;
		_brick.SetAnimation("enemy-dead");
		bricks-=[_brick];
	}
	function delete_rock(_rock){
		if(_rock.touch_for_die==0){
			delete _rock;
			rocks-=[_rock];
		}else{
			_fx=_rock.CreateFX("TINT");
			_fx.Start(1000, RGB(255,0,0));
			_rock.touch_for_die--;
		}
	}


	function delete_objects(delete_btick=true){
		if(delete_btick){
			for(i=0; i<sizeof(bricks);i++)delete bricks[i];
			bricks=[];
		}
		
		//borramos todos los bricks que sean fallibles

		for(i=0; i<sizeof(bricks);i++) {
			if(bricks[i].fallible) delete_brick(bricks[i]);
		}
		
		

		for(i=0; i<sizeof(capsules);i++)delete capsules[i];
		capsules=[];
		for(i=0; i<sizeof(balls);i++)delete balls[i];
		balls=[];
		for(i=0; i<sizeof(lasers);i++)delete lasers[i];
		lasers=[];
		for(i=0; i<sizeof(enemies);i++)delete enemies[i];
		enemies=[];
		for(i=0; i<sizeof(rocks);i++)delete rocks[i];
		rocks=[];
		delete bricks;
		delete balls;
		delete capsules;
		delete lasers;
		delete enemies;
		delete rocks;
	}	




	virtual _operator_delete(){
		app.Log("deleting game");
		delete_objects();
		delete text_hud;
		delete board_bg;
		delete ornament_hud;
		delete player;
		delete ball;
		timer_game.Stop();
		delete timer_game;
	}


