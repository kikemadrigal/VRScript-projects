namespace es_tipolisto_arkandroid;
//
class Level24{
	properties:
		game=null;
        map=null;
		boss=null;
	function _operator_new(_game){
		game=_game;
		map=[
			[" "," "," "," "," "," "," "," "," "," "," "],
			[" "," "," "," "," "," "," "," "," "," "," "],
			[" "," "," "," "," "," "," "," "," "," "," "],
			[" "," "," "," "," "," "," "," "," "," "," "],
			["r"," "," "," "," "," "," "," "," "," ","r"],
			["r"," "," "," "," ","m"," "," "," "," ","r"],
			["r"," ","r"," "," ","m"," "," ","r"," ","r"],
			["r"," ","r"," "," ","m"," "," ","r"," ","r"],
			["r"," ","r"," "," ","m"," "," ","r"," ","r"],
			[" "," "," "," "," "," "," "," "," "," "," "],
			[" "," "," "," "," "," "," "," "," "," "," "]
		];
		game.DrawMap(map);
		boss=game.app.NewObject("boss4","Boss4",null,[game, game.player]);
		game.mode_boss=true;
	}
	function _operator_delete(){
		delete map;
		delete boss;
		game.delete_objects();
	}   
}