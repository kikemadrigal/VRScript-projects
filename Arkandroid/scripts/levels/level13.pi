namespace es_tipolisto_arkandroid;
//Jupiter: el pez
/*
	a=amarillo
	g=gris
	m=morado
	r=rojo
	v=verde
	z=azul oscuro
	o=azul claro

	d=dinamita
	f=Flash

	ab, gb, mb, zb, rb, vb, ob bombas que destruyen el mismo color
	af, gf, mf, zf, rf, vf, of rocas que tiemblan disparan o caen
*/
class Level13{
	
	properties:
		game=null;
        map=null;	
	function _operator_new(_game){
		game=_game;
		map=[
			[" "," "," "," "," "," "," "," "," "," "," "],
			[" "," "," "," "," "," "," "," "," "," "," "],
			[" "," ","z","z","z","z"," "," "," "," "," "],
			[" ","z"," "," "," "," ","z"," ","o","o","of"],
			["z"," ","a"," "," "," "," ","z"," "," "," "],
			["z"," "," "," "," "," "," ","z"," "," "," "],
			[" ","f","f"," "," "," ","z"," ","o","o","of"],
			[" "," "," z","z","z","z","gf"," "," "," "," "],
			[" "," "," "," ","gf"," "," "," "," "," "," "],
			[" "," "," "," "," "," "," "," "," "," "," "],
			[" "," "," "," "," "," "," "," "," "," "," "]
		];
		game.DrawMap(map);

	}
	function _operator_delete(){
		delete map;

		game.delete_objects();
	}   

}