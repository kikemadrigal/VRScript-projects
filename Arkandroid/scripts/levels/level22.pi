namespace es_tipolisto_arkandroid;
//22. Miranda-Urano: bloques de oro\ny plata en forma de romb
class Level22{
	properties:
		game=null;
        map=null;

	function _operator_new(_game){
		game=_game;
map=[
			[" "," "," "," "," "," "," "," "," "," "," "],
			[" "," "," "," "," "," "," "," "," "," "," "],
			[" "," "," "," "," ","f"," "," "," "," "," "],
			[" "," "," "," ","x"," ","x"," "," "," "," "],
			[" "," "," ","x"," ","p"," ","x"," "," "," "],
			[" "," ","f"," ","p","d","p"," ","f"," "," "],
			[" "," "," ","x"," ","p"," ","x"," "," "," "],
			[" "," "," "," ","x"," ","x"," "," "," "," "],
			[" "," "," "," "," ","f"," "," "," "," "," "],
			[" "," "," "," "," "," "," "," "," "," "," "],
			[" "," "," "," "," "," "," "," "," "," "," "]
		];
		game.DrawMap(map);

	}
	function _operator_delete(){
		delete map;
		game.delete_objects();
	}   
}