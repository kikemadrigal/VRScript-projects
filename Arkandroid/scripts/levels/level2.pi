namespace es_tipolisto_arkandroid;

class Level2 {
	properties:
		game=null;
        map=null;
		
	function _operator_new(_game){
		game=_game;
		map=[
			[" "," "," "," "," "," "," "," "," "," "," "],
			[" "," "," "," "," "," "," "," "," "," "," "],
			[" "," "," "," "," "," "," "," "," "," "," "],
			[" "," ","a","g","m"," ","r","v","o"," "," "],
			[" "," ","a","g","m"," ","r","v","o"," "," "],
			[" "," ","a","g","m","z","r","v","o"," "," "],
			[" "," ","ab","gb","mb","zb","rb","vb","ob"," "," "],
			[" "," "," "," "," "," "," "," "," "," "," "],
			[" "," "," "," "," "," "," "," "," "," "," "],
			[" "," "," "," "," "," "," "," "," "," "," "],
			[" "," "," "," "," "," "," "," "," "," "," "]
		];
		game.DrawMap(map);

	}


	function _operator_delete(){
		delete map;
	}
}