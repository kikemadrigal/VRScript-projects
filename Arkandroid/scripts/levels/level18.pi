namespace es_tipolisto_arkandroid;
//3 boss,Saturno:  3. jefe;  Nave que te persigue y te dispara
class Level18{
	properties:
		game=null;
        map=null;
		boss=null;

	function _operator_new(_game){
		game=_game;
		map=[
			[" "," "," "," "," "," "," "," "," "," "," "],
			[" "," "," "," "," "," "," "," "," "," "," "],
			[" "," "," "," "," "," "," "," "," "," "," "],
			[" "," "," "," "," "," "," "," "," "," "," "],
			[" "," "," ","r","r"," ","r","r"," "," "," "],
			[" "," "," "," "," "," "," "," "," "," "," "],
			[" "," "," "," "," "," "," "," "," "," "," "],
			["r","r","r"," ","r","r","r"," ","r","r","r"],
			[" "," "," "," "," "," "," "," "," "," "," "],
			[" "," "," "," "," "," "," "," "," "," "," "],
			[" "," "," "," "," "," "," "," "," "," "," "]
		];
		boss=game.app.NewObject("boss3","Boss3",null,[game]);
	}
	function _operator_delete(){
		delete map;
		delete boss;
	}   
}