namespace es_tipolisto_arkandroid;

class Level6 {
	properties:
		game=null;
        map=null;
		boss=null;
	function _operator_new(_game){
		game=_game;
		map=[
			[" "," "," "," "," "," "," "," "," "," "," "],
			[" "," "," "," "," "," "," "," "," "," "," "],
			[" "," "," "," "," "," "," "," "," "," "," "],
			[" "," "," "," "," "," "," "," "," "," "," "],
			[" "," "," "," "," "," "," "," "," "," "," "],
			["r","r"," "," "," "," "," "," "," ","r","r"],
			["r","r"," "," "," "," "," "," "," ","r","r"],
			[" "," "," "," "," "," "," "," "," "," "," "],
			[" "," "," "," "," "," "," "," "," "," "," "],
			[" "," "," "," "," "," "," "," "," "," "," "],
			[" "," "," "," "," "," "," "," "," "," "," "]
		];
		game.DrawMap(map);
		
		boss=game.app.NewObject("boss1","Boss1",null,[game, game.player]);
		game.mode_boss=true;
	}
	function _operator_delete(){
		delete boss;
		delete map;
	}   



}