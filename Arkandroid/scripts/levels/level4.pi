namespace es_tipolisto_arkandroid;

class Level4{
	properties:
		game=null;
        map=null;

	function _operator_new(_game){
		game=_game;
		map=[
			[" "," "," "," "," "," "," "," "," "," "," "],
			[" "," "," "," "," "," "," "," "," "," "," "],
			[" "," "," "," "," "," "," "," "," "," "," "],
			[" "," ","b","b"," "," "," ","b","b"," "," "],
			[" ","b","p","p","b"," ","b","p","p","b"," "],
			[" ","b","x","x","b"," ","b","x","x","b"," "],
			[" ","b","p","p","b"," ","b","p","p","b"," "],
			[" "," ","b","b"," "," "," ","m","m"," "," "],
			[" "," "," "," "," "," "," "," "," "," "," "],
			[" "," "," "," "," "," "," "," "," "," "," "],
			[" "," "," "," "," "," "," "," "," "," "," "]
		];
		game.DrawMap(map);

	}
	function _operator_delete(){
		delete map;
	}
   
}