namespace es_tipolisto_arkandroid;

class Level5 {
	properties:
		game=null;
        map=null;

	function _operator_new(_game){
		game=_game;
		map=[
			[" "," "," "," "," "," "," "," "," "," "," "],
			["gf","gf","a"," "," "," "," "," ","a","gf","gf"],
			[" "," "," ","a"," "," "," ","a"," "," "," "],
			[" "," "," ","g","g"," ","g","g"," "," "," "],
			[" "," ","g","g","g"," ","g","g","g"," "," "],
			[" "," ","g","g","g","m","g","g","g"," "," "],
			[" "," "," ","g"," "," "," ","g"," "," "," "],
			[" "," "," ","g","g"," ","g","g"," "," "," "],
			[" "," "," "," "," "," "," "," "," "," "," "],
			[" "," "," "," "," "," "," "," "," "," "," "],
			[" "," "," "," "," "," "," "," "," "," "," "]
		];
		game.DrawMap(map);

	}
	function _operator_delete(){
		delete map;
	}
   
}