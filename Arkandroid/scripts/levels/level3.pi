namespace es_tipolisto_arkandroid;

class Level3 {
	properties:
		game=null;
        map=null;

	function _operator_new(_game){
		game=_game;
		map=[
			[" "," "," "," "," "," "," "," "," "," "," "],
			[" "," "," "," "," "," "," "," "," "," "," "],
			[" "," "," "," "," "," "," "," "," "," "," "],
			[" "," "," "," "," "," "," "," "," "," "," "],
			[" "," "," "," ","g","g"," "," ","g","g"," "],
			[" "," "," ","g","g","g"," ","g","g","g"," "],
			[" ","m","m","g","g","g","g","g","g"," "," "],
			[" "," "," ","g","g","g"," ","g","g","g"," "],
			[" "," "," "," ","g","g"," "," ","g","g"," "],
			[" "," "," "," "," "," "," "," "," "," "," "],
			[" "," "," "," "," "," "," "," "," "," "," "]

		];
		game.DrawMap(map);

	}
	function _operator_delete(){
		delete map;
	}
   
}