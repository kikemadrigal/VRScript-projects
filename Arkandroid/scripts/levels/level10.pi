namespace es_tipolisto_arkandroid;
//10. Ganimedes-Júpiter: pirámide
class Level10{
	properties:
        map=null;
		/*
			a=amarillo
			g=gris
			m=morado
			r=rojo
			v=verde
			z=azul oscuro
			o=azul claro

			d=dinamita
			f=Flash

			ab, gb, mb, zb, rb, vb, ob bombas que destruyen el mismo color
			af, gf, mf, zf, rf, vf, of rocas que tiemblan disparan o caen
		*/
	function _operator_new(){
		map=[
			[" "," "," "," "," "," "," "," "," "," "," "],
			[" "," "," "," "," "," "," "," "," "," "," "],
			[" "," "," "," "," ","p"," "," "," "," "," "],
			[" "," "," "," "," ","g"," "," "," "," "," "],
			[" "," "," "," ","p","g","p"," "," "," "," "],
			[" "," "," ","p","ab","g","ab","p"," "," "," "],
			[" "," ","p","a","a","g","a","a","p"," "," "],
			[" ","p","a","a","a","gb","a","a","a","p"," "],
			[" "," "," "," "," "," "," "," "," "," "," "],
			[" "," "," "," "," "," "," "," "," "," "," "],
			[" "," "," "," "," "," "," "," "," "," "," "]
		];
	}
	function _operator_delete(){
		delete map;
	}   
}