namespace es_tipolisto_arkandroid;

class Level7{
	properties:
		game=null;
        map=null;
		
		//time=0;
		//rocks=[];
	function _operator_new(_game){
		game=_game;
		map=[
			[" "," "," "," "," "," "," "," "," "," "," "],
			[" "," "," "," "," "," "," "," "," "," "," "],
			[" "," ","gb","m","o","m","r","m","gb"," "," "],
			[" "," "," ","a","o","a","r","a"," "," "," "],
			[" "," "," "," ","ob","p","rb"," "," "," "," "],
			[" "," "," "," "," ","p"," "," "," "," "," "],
			[" "," "," "," "," ","p"," "," "," "," "," "],
			[" "," "," "," "," ","p"," "," "," "," "," "],
			[" "," "," "," ","a","p"," "," "," "," "," "],
			[" "," "," "," "," "," "," "," "," "," "," "],
			[" "," "," "," "," "," "," "," "," "," "," "]
		];
		game.DrawMap(map);

	}
	function _operator_delete(){
	
		delete map;
		game.delete_objects();
	}   


}