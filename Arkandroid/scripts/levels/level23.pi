namespace es_tipolisto_arkandroid;
//23. Urano: bloques de oro y plata\nen forma de cruz
/*
	a=amarillo
	g=gris
	m=morado
	r=rojo
	v=verde
	z=azul oscuro
	o=azul claro

	d=dinamita
	f=Flash

	ab, gb, mb, zb, rb, vb, ob bombas que destruyen el mismo color
	af, gf, mf, zf, rf, vf, of rocas que tiemblan disparan o caen
*/
class Level23{
	properties:
		game=null;
        map=null;
	

	function _operator_new(_game){
		game=_game;
		map=[
			[" "," "," "," "," "," "," "," "," "," "," "],
			[" "," "," "," "," "," "," "," "," "," "," "],
			[" ","f"," "," "," "," "," "," "," ","f"," "],
			[" ","x"," "," "," ","p"," "," "," ","x"," "],
			[" ","x"," "," "," ","p"," "," "," ","x"," "],
			[" ","x"," "," "," ","gf"," "," "," ","x"," "],
			[" ","x"," "," ","gf"," ","gf"," "," ","x"," "],
			[" "," ","af","af"," "," "," ","af","af"," "," "],
			[" "," "," "," "," "," "," "," "," "," "," "],
			[" "," "," "," "," "," "," "," "," "," "," "],
			[" "," "," "," "," "," "," "," "," "," "," "]
		];
		game.DrawMap(map);

	}
	function _operator_delete(){
		delete map;
	
		game.delete_objects();
	}   
}