namespace es_tipolisto_arkandroid;

class Laser implements GL_sprite{
	properties:
		game=null;
		type="normal";
		incrementoY=0;
	virtual _operator_new(_name,_creator,_params){
		game=_params[0];
		_x=_params[1];
		_y=_params[2];
		type=_params[3];
		AddEmptyframe(5,10);
		SetColor(RGB(255,255,0));
		SetCollision(True);
		SetPos(_x,_y);	
		Setcollidermode(true);	
		if(type=="normal") incrementoY=-5;
		else if(type=="enemy") incrementoY=2;
	}
	virtual Move(){
		incpos(0,incrementoY);
		//if(GetY()<0 || GetY()>game.app.BOARD_HEIGHT){
		//if(GetY()<0 || GetY()>450){
		if(GetY()<0 || GetY()>GetApp().BOARD_HEIGHT){
			Destroy();
			game.lasers-=[this];
		}
	}
    function OnSpriteCollision(_self, _spr){
		if(	Class_Id(_spr)=="Ball" || 
			Class_Id(_spr)=="Capsule" || 
			Class_Id(_spr)=="Laser" ) return;
		if(Class_Id(_spr)=="Brick" && type=="enemy") return;
		if(Class_Id(_spr)=="Enemy" && type=="normal"){
			game.delete_enemy(_spr);
			game.draw_HUD();
		}
        if(Class_Id(_spr)=="Brick" && type=="normal"){
			game.delete_brick(_spr);
            game.draw_HUD();
			if(sizeof(game.bricks)<=0 && !game.mode_boss){
                game.ChangeLevel();
            }
        }
		if(Class_Id(_spr)=="Rock" ){
			game.delete_rock(_spr);	
		}
		if(Class_Id(_spr)=="player" && type=="enemy"){
			game.player_die();
		}


		Destroy();
		game.lasers-=[this];
    }
}