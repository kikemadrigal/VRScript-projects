class EjecutorBat implements DOS_Program
{
    virtual Start()
    {
        _console = GetDOS().GetConsole();
        _console.PrintLn("--- Iniciando Ejecución de Script ---");
        _console.PrintLn("Lanzando archivo: install.bat");
        _ruta=GetEngine().GetPath("./install.bat");
        GetEngine().RunProgram(_ruta);
        End(0);
    }
}