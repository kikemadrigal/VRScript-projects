namespace es_tipolisto_arkandroid;

class Game implements App{
/**
 * Los tablerso del juego es una matriz de rocas
 * cada uno de los elementos de la matriz es un string que representa el tipo de ladrillo
 */
	properties:
		level=0;
		text_hud=null;
		player=null;
		ball=null;
		bricks=[];
		balls=[];
		capsules_type=["laser","3ball","laser","laser","live","3ball","largue","laser","next","bomb","clock","shield"];
		missions=[
			"\n1. Mercurio:\n-Los bloques de tipo \ndinamita destruyen lo \nque haya a su alrededor.\n-Los de tipo flash te dejan ciego \ndurante 1 destello",
			"\n2. Venus:\n-Los bloques de tipo \nbomba eliminan las rocas\n del color de la bomba.",
			"\n3. La luna, Capsulas:\n-Laser; permite disparar.\n-3ball; genera 3 bolas.\n-Largue; aumenta tu nave.\n-Next; siguiente nivel.\n-Bomb: bomba extra\n-Clock: disminuye velocidad bala.\n-Shield: escudo",
			"\n4. Tierra: \n-Oro necesitan \n 3 toques para ser destruidas \n-Plata necesitan 2 toques,\n-Bronce necesitan 1 toque.",
			"\n5. Fobos-Marte: Las rocas que tiemblan \ndisparan al ser golpeadas.",
			"\n6. Deimos-Marte: 1. jefe, creador de ladrillos",
			"\n7. Marte: El paraguas",	
			"\n8. Europa-Júpiter: pelota ",
			"\n9. Io-Júpiter: Estrella",
			"\n10. Ganimedes-Júpiter: pirámide",
			"\n11. Amaltea-Jupiter: Rombo",
			"\n12. Calisto-Jupiter: 2. Jefe; el n lanza meteoritos.",
			"\n13. Jupiter: el pez",
			"\n14. Titán-Saturno:  La cara",
			"\n15. Encelado-Saturno: cucurucho",
			"\n16. Mimas-Saturno: El caracol",
			"\n17. Dione-Saturno: Cruz de cristo",
			"\n18. Saturno:  3. jefe;  Creador \nde naves.",
			"\n19. Setebos-Urano: bloques oro\ ny plata en hilera laberinto",
			"\n20. Umbrial-Urano: bloques verticales \nde oro y lata y normales",
			"\n21. Titania-Urano: bloque de oro \npor abajo en forma\nde U invertida",
			"\n22. Miranda-Urano: bloques de oro \ny plata en forma de rombo",
			"\n23. Urano: bloques de oro y plata \nen forma de uve doble",
			"\n24. Neptuno: 4. jefe y final; \nLanza de todo."
		];
		capsules=[];
		rocks=[];
		enemies=[];
		level_active=null;
		board_bg=null;
		ornament_hud=null;
		lasers=[];
		timer_game=null;
		time=0;
		mode_boss=false;
		arrow=null;
		//rock_template=null;
	virtual _operator_new(_app){
		//Adorno marcador
		_ornament_hud=app.NewObject("ornament_hud","GL_Sprite");
		//_ornament_hud.AddFrame("res/ornament_hud.png",280,app.BOARD_HEIGHT);
		_ornament_hud.AddFrame("res/ornament-hud.png");
		_ornament_hud.SetPos(app.BOARD_WIDTH,0);
		_ornament_hud.SetPriority(app.PRIORITY_BG);
		ornament_hud=_ornament_hud;

		_arrow=app.NewObject("arrow","GL_Sprite");
		_arrow.AddFrame("res/arrow.png");
		_arrow.SetPos(680,55);
		_arrow.SetSize(30,30, true);
		//_arrow.SetPriority(app.PRIORITY_BG);
		arrow=_arrow;

		_board_bg=app.NewObject("board_bg","GL_Sprite");
		_board_bg.AddFrame("res/level1.png");
		_board_bg.SetPriority(app.PRIORITY_BG);
		board_bg=_board_bg;

		//El marcador con las vidas y la puntuciÃ³n
		_text_hud=app.NewObject("text","GL_Text");
		_text_hud.SetFont("fonts/Vintage Black.ttf", 12);
		_text_hud.SetColor(RGB(255,255,0));
		_text_hud.SetPos(app.BOARD_WIDTH+20,20);
		text_hud=_text_hud;

		//Player 1
		_player=app.NewObject("player", "Player", null, [this, app.BOARD_WIDTH/2, app.GetResY()-100, False]);
		_player.SetVisible(False);
		_player.SetPriority(APP.PRIORITY_PLAYER);
		_player.lives=5;
		_player.score=0;
		_player.SetPos(app.BOARD_WIDTH/2,app.GetResY()-40);
		_player.SetVisible(True);
		player=_player;

		//Creamos la bola
		_ball=app.NewObject("ball","Ball",null,[this, app.BOARD_WIDTH/2, app.GetResY()/2]);
		_ball.SetVisible(False);
		_ball.SetPriority(APP.PRIORITY_BALL);
		_ball.SetVisible(True);
		ball=_ball;

		//Ponemos el marcador
		text_hud.SetVisible(True);

		//Pintamos el nivel
		ChangeLevel();

		//El timer game nos sirve para llevar un contador de tiempo
		timer_game=app.NewObject("timer", "GL_Timer");
		timer_game.SetFrequency(1000);
		timer_game.SetUserCallBack(this,"OnTimerGame");
		timer_game.Stop();
		//Ponemos la música
		app.resources.PlaySoundGameStart();
	}
	
	
	virtual _operator_delete(){
		app.Log("Borrando game");
		delete_objects();
		delete text_hud;
		delete board_bg;
		delete ornament_hud;
		delete player;
		delete ball;
		timer_game.Stop();
		delete timer_game;
	}

	function DrawMap(map){
		//// 1. Creamos el objeto que servirá de molde
		//_brick_template=CreateBrick(100,100,"normal");
		 // 2. Creamos un pool de 40 instancias para este objeto
		//_brick_template.CreateInstancesPool(40);
		for (_y=0;_y<sizeof(map);_y++){
			fila=map[_y];
			for (_x=0;_x<sizeof(map[_y]);_x++){
				_type=map[_y][_x];
				CreateBrick(_x+1,_y,_type);
				// 3. pedimos una instancia rápida del pool, InstancedObject compartirá comportamiento y animaciones con el molde [5]
        		/*_brick = app.InstancedObject("rock", _brick_template);
				_brick.SetPos( _x+1*app.BRICK_WIDTH,_y*app.BRICK_HEIGHT);
				_brick.SetVisible(true);
        		_brick.SetStop(false);
				bricks+=[_brick];*/
			}
		}
	}

	function draw_HUD(){
		_message="Screen: "+level;
		_message="\nHighscore:  \n"+player.high_score+"\nScore: \n"+player.score+"\nLives:  \n"+player.lives;
		_message+="\nBall speed: "+ball.speed;
		_message+="\nBricks: "+sizeof(bricks);
		if(player.timer_is_actuve) _message+="\nPower-up: "+player.type+": "+player.time_to_normal;
		else _message+="\nPower-up: None";
		_message+="\nBombs: "+player.counter_bombs+", pulsa Ctrl para usarla";
		_message+="\nEscudos: "+player.shields+", pulsa Shift para usarlos";
		_message+="\nFrequency: "+GetFPS()+" Ftime: "+GetFTime()*0.025f;
		//_message+="\nball incX: "+ball.incposX+" incY: "+ball.incposY;
		//_message+="\ntime: "+time;
		//_message+="\nplayer x: "+player.GetX()+", y: "+player.GetY();
		//_message+="\nBall speed: "+ball.speed+" incX: "+ball.incposX+" incY: "+ball.incposY;
		//_message+="\nNum lasers: "+sizeof(lasers);
		//_message+="\nNum enemies: "+sizeof(enemies);
		//_message+="\nRocks: "+sizeof(rocks);
		//_message+="\nCapsules: "+sizeof(capsules);
		if(mode_boss) _message+="\nBoss life: "+level_active.boss.boss_live;
		_message+="\nMission: "+missions[level-1];
		
		text_hud.SetText(_message);
		//show_map();
	}

	function OnTimerGame(_timer){
		time++;
		if(time>1000) time=0;
		draw_HUD();
		//cada 10 segundos aumnentamos la velocidad de la bola
		if(time%10==0 && ball.speed<5){
			ball.speed+=0.5;
		}

		if(level>6 && level<12) {
			if(sizeof(rocks)==0)create_rock();
		}else if(level>12 && level<18){
			if(sizeof(enemies)==0)create_enemy(rand(0,3));
		}else if(level>18 && level<24){
			if(sizeof(enemies)==0)create_enemy(6);
		}
	}
	
	
	function ChangeLevel(){
		//delete app.GetActiveStage();
		//app.log("Cambiamos al level "+level);
		if(level>0){
			app.text_game.SetText("level completed");
			//app.GetEngine().sleep(2000);
			board_bg.RemoveFrames();
			_level_for_board=level+1;
			board_bg.AddFrame("res/level"+_level_for_board+".png");
		}
		if(mode_boss)moes_boss=false;
		timer_game.Stop();
		level++;
		delete_objects();
		if(level_active!=null) delete level_active;
		if(level==6 || level==12 || level==18 || level==24 || level==25) {
			mode_boss=true;
			switch (level){
				case 6:
					level_active=new Level6(this);
					break;
				case 12:
					level_active=new Level12(this);
					break;
				case 18:
					level_active=new Level18(this);
					break;
				case 24:
					level_active=new Level24(this);
					break;
				case 25:
					app.Log("Vamos a pasar al stado game_over");
					app._change("game_over");
					break;
			}
		}else {
			level_active=_eval("new Level" + string(level) + "()");
		}
		//level_active=new eval(new_level)();
		DrawMap(level_active.map);

		app.resources.PlaySoundGameStart();
		app.gamePaused=true;
		player.player_return_normal();
		app.resources.PlaySoundGameStart();
		app.gamePaused=true;
		player.player_return_normal();
		ball.ball_return_normal();
		app.SetFrameRate(60);
		draw_HUD();
	}



	
	function CreateBrick(_x,_y,_type){
		_brick=null;
		if (_type!=" " ){
			_brick=app.NewObject("brick","Brick",null, [this, _x*app.BRICK_WIDTH,_y*app.BRICK_HEIGHT, _type]);
			bricks+=[_brick];
		}		
		return _brick;
	}
	function CreateCapsule(_x,_y, with_probability=true){
		if(with_probability){
			_number_for_capsule=Rand(0,100);
			//app.log("Vamos a crear un capsula con probabilidad "+_number_for_capsule+" modo boss "+mode_boss);
			if(_number_for_capsule<20){
				_type=capsules_type[Rand(0,sizeof(capsules_type)-1)];
				//app.log("capsula creada tipo "+_type);
				if(mode_boss){
					if(_type!="next" && _type!="laser"){
						//app.log("Creamos la capsula "+_type);
						_capsule=app.NewObject("capsule","Capsule",null, [this, _x,_y, _type]);
						capsules+=[_capsule];
					}
				}else{
					_capsule=app.NewObject("capsule","Capsule",null, [this, _x,_y, _type]);
					capsules+=[_capsule];
				}
			}
		}else{
			_type=capsules_type[Rand(0,sizeof(capsules_type)-1)];
			_capsule=app.NewObject("capsule","Capsule",null, [this, _x,_y, _type]);
			capsules+=[_capsule];
		}
	}
	function create_ball(_number_of_balls){
		_ball=app.NewObject("ball"+_number_of_balls,"Ball",null,[this, app.BOARD_WIDTH/2+(_number_of_balls*20), app.BOARD_HEIGHT/2]);
		_ball.SetVisible(True);
		_ball.SetColor(RGB(255,0,0));
		_ball.SetPriority(APP.PRIORITY_BALL);
		_ball.multiball=true;
		_ball.incposY=-4;
		balls+=[_ball];
		return _ball;
	}

	function create_enemy(_type=0){
		_enemy=app.NewObject("enemy"+Rand(0,1000),"Enemy",null,[this,_type]);
		enemies+=[_enemy];
		return _enemy;
	}

	function create_rock(){
		_rock=app.NewObject("rock"+Rand(0,1000),"Rock",null,[this, Rand(0, app.BOARD_WIDTH-76), 10]);
		rocks+=[_rock];
		return _rock;
	}

	function createLaser(_x,_y,_type){
		_laser=app.NewObject("laser","Laser",null,[this,_x, _y,_type]);
		lasers+=[_laser];
	}


	function player_die(){
		if(player.type=="shield") {
			player.player_return_normal();
			return;
		}
		player.lives--;
		delete_objects(false);
		timer_game.Stop();
		ball.SetPos(app.GetResX()/2,app.GetResY()/2);
		ball.ball_return_normal();
		player.player_return_normal();
		//Borramos el timer si existe
		if(player.timer_is_actuve) {
			delete player.timer_return_normal;
			player.timer_is_actuve=false;
		}
		//borramos las bolas extra si existen
		if(sizeof(balls)>0){
			for(i=0;i<sizeof(balls);i++){
				if(balls[i]!=ball) {
					delete balls[i];
					balls-=[balls[i]];
				}
			}
		}

		if(mode_boss){
			level_active.boss.SetPos(app.BOARD_WIDTH/2,40);
			app.gamePaused=true;
			level_active.boss.Stop();
		}
		
		if(player.lives<=0){
			delete_objects();
			app.resources.PlaySoundGameOver();
			app.text_game.SetText("Game Over");
			app.GetEngine().sleep(2000);
			/*if(app.db.CheckRecord(player.score)){
				app.gl.Stop();
				_textModal="Nuevo record!!!";
				do{
					name=app.GetEngine().InputDialogModal(_textModal,"",View.AD_OK,"");
					_textModal="El nombre no puede estar vacÃ­o ni ser menor de 4 caracteres";
				}while(name=="" || strlen(name)<=3);
				app.Log("El nombre introducido es "+name);
				app.db.InsertRecord(name,player.score);
				app.db.UpdateUserRecord(player.score);
				app.gl.Start();
			}*/

			if (app.db.CheckRecord(player.score)){
				app.gl.Stop();
				app.GetEngine().AlertDialog("Alert", "new record", 0, null, null);
				_name_for_new_record=app.db.GetUser();
				app.db.InsertRecord(_name_for_new_record, player.score);
				app.gl.Start();
			}
			
			player.score=0;
			player.lives=5;
			app.menu=new Menu(app);  
			app.gameOver=True;
			ball.speed=0;
			ball.SetVisible(False);
			player.SetVisible(False);
			level=0;
			app._change("menu");
			
		}else{
			app.gamePaused=True;
		}
		draw_HUD();
	}

	function delete_enemy(_enemy){
		if(_enemy.touch_for_die==0){
			delete _enemy;
			enemies-=[_enemy];
		}else{
			_fx=_enemy.CreateFX("TINT");
			_fx.Start(1000, RGB(255,0,0));
			_enemy.touch_for_die--;
		}
	
	}
	function delete_brick(_brick){
		//Si 11 tile son 520 pixeles de ancho
		//    x            100pixeñes 
		//Borramos el brick del array del nivel
		//_tiles_in_rowx=app.BOARD_WIDTH/11;
		//_tiles_in_rowy=app.BOARD_HEIGHT/11;
		_tile_x=floor(_brick.GetX()/40);
		_tile_y=floor(_brick.GetY()/20);
		level_active.map[_tile_y+1][_tile_x-1]=" ";
	
		//app.Log("Borramos el brick: "+_tile_y+" "+_tile_x);
		//delete _brick;
		_brick.SetAnimation("enemy-dead");
		bricks-=[_brick];
	}
	function delete_rock(_rock){
		if(_rock.touch_for_die==0){
			delete _rock;
			rocks-=[_rock];
		}else{
			_fx=_rock.CreateFX("TINT");
			_fx.Start(1000, RGB(255,0,0));
			_rock.touch_for_die--;
		}
	}


	function delete_objects(delete_btick=true){
		if(delete_btick){
			for(i=0; i<sizeof(bricks);i++)delete bricks[i];
			bricks=[];
		}
		
		//borramos todos los bricks que sean fallibles

		//for(i=0; i<sizeof(bricks);i++) {
		//	if(bricks[i].fallible) delete_brick(bricks[i]);
		//}
		
		

		for(i=0; i<sizeof(capsules);i++)delete capsules[i];
		capsules=[];
		for(i=0; i<sizeof(balls);i++)delete balls[i];
		balls=[];
		for(i=0; i<sizeof(lasers);i++)delete lasers[i];
		lasers=[];
		for(i=0; i<sizeof(enemies);i++)delete enemies[i];
		enemies=[];
		for(i=0; i<sizeof(rocks);i++)delete rocks[i];
		rocks=[];
		delete bricks;
		delete balls;
		delete capsules;
		delete lasers;
		delete enemies;
		delete rocks;
	}	







}