namespace es_tipolisto_arkandroid;
//LEVEL 19. Setebos-Urano: Bloques oro y plata en hilera laberinto
/*
	a=amarillo
	g=gris
	m=morado
	r=rojo
	v=verde
	z=azul oscuro
	o=azul claro

	x=Oro
	p=plata
	b=bronce
	t=titanio indesctructible

	d=dinamita
	f=Flash

	ab, gb, mb, zb, rb, vb, ob bombas que destruyen el mismo color
	af, gf, mf, zf, rf, vf, of rocas que tiemblan disparan o caen
*/
class Level19{
	properties:
        map=null;

	function _operator_new(){
		map=[
			[" "," "," "," "," "," "," "," "," "," "," "],
			[" "," ","p","p","p","p","p","p"," "," "," "],
			[" ","p"," ","x","x","x"," "," "," "," "," "],
			[" ","p","x"," "," "," ","x"," "," "," "," "],
			[" ","p"," ","x","x","x"," ","p"," "," "," "],
			[" "," ","p","p","p","p","p","p"," "," "," "],
			[" "," ","a","a","a","a","a"," "," "," "," "],
			[" "," "," "," "," "," "," "," "," "," "," "],
			[" "," "," "," "," "," "," "," "," "," "," "],
			[" "," "," "," "," "," "," "," "," "," "," "],
			[" "," "," "," "," "," "," "," "," "," "," "]
		];
	}
	function _operator_delete(){
		delete map;
	}   
}