class Snow implements GL_Sprite
{
    properties:
        // Por defecto las texturas usan un wrap de tipo CLAMP o sea, las coordenadas de textura siempre quedan entre 0 y 1.
        u = 0;
        angle = 0;
        factor = 2;
        speed = 0.01f;

    virtual _operator_new(_name, _creator)
    {
        SetFlags(FLAG_UVWRAP);
        AddFrame("images/copos.png", GetGL().GetResX(), GetGL().GetResY());
        SetAlpha(100);
    }

    virtual Move()
    {
        //Movemos u para dar efecto de scroll infinito
        //El GetFTime() es una función que devuelve un factor relativo al framerate en marcha
        u +=  speed * GetFTime();
        SetUV(u+sin(angle)*speed, -u, factor, factor);
        angle += GetFTime() * 0.1f;
    }
}