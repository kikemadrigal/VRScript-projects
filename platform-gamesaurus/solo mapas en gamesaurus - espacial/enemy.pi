namespace es_tipolisto_kirk;

class Enemy implements GL_sprite{
    properties:
        stage=null;
    virtual _operator_new(_name,_creator, _params){
		Addanimationwithsheet("enemy","images/enemy.png",0,1,0,0,64,64,-1,-1,-1,.2);
		SetCollision(True);
        stage=GetApp().GetActiveStage();
        //player=creator.FindObject("player");
    }


    virtual Move(){
        //EMovemos al enemigo de derecha a izquierda
        if(GetX()<stage.GetCameraX()+64){
            SetPos(stage.GetCameraX()+700,300);
        }
        incPos(-2,0);
    }


    
