namespace es_tipolisto_arkandroid;

class Laser implements GL_sprite{
	properties:
		game=null;
		type="normal";
		incrementoY=0;
	virtual _operator_new(_name,_creator,_params){
		game=_params[0];
		//_x=_params[1];
		//_y=_params[2];
		type=_params[1];
		AddEmptyframe(5,10);
		SetColor(RGB(255,255,0));
		SetVisible(true);
		SetStop(false);
		SetCollision(false);
		//SetPos(_x,_y);	
		Setcollidermode(true);	
		if(type=="normal") incrementoY=-5;
		else if(type=="enemy") incrementoY=2;
	}
	virtual Move(){
		incpos(0,incrementoY);
		//if(GetY()<0 || GetY()>game.app.BOARD_HEIGHT){
		//if(GetY()<0 || GetY()>450){
		if(GetY()<0 || GetY()>GetApp().BOARD_HEIGHT){
			//Destroy();
			game.delete_laser(this);
		}
	}
    function OnSpriteCollision(_self, _spr){
		if(	Class_Id(_spr)=="Ball" || 
			Class_Id(_spr)=="Capsule" || 
			Class_Id(_spr)=="Laser" ) return;
		else if(Class_Id(_spr)=="Rock" && type=="enemy") return;
		else if(Class_Id(_spr)=="Enemy" && type=="normal"){
			game.delete_enemy(_spr);
			game.draw_HUD();
		}
        else if(Class_Id(_spr)=="Rock" && type=="normal"){
			IF(_spr.type!="i1" && _spr.type!="i2" && _spr.type!="i3" && _spr.type!="i4"){
				game.delete_rock(_spr);
           	 	game.draw_HUD();
			}

			/*if(sizeof(game.rocks)<=0 && !game.mode_boss){
                game.ChangeLevel();
            }*/
        }
		else if(Class_Id(_spr)=="RockFall" ){
			game.delete_rock_fall(_spr);	
		}
		else if(Class_Id(_spr)=="Meteor" ){
			game.delete_meteor(_spr);	
		}
		else if(Class_Id(_spr)=="player" && type=="enemy"){
			game.player_die();
		}


		//Destroy();
		//game.lasers-=[this];
		game.delete_laser(this);
    }

	function set_type(_type){
		type=_type;
		if(type=="normal") incrementoY=-5;
		else if(type=="enemy") incrementoY=2;
	}
}