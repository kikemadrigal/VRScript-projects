namespace es_tipolisto_arkandroid;
/**
  * Los metoritos aparecen en la fase 2 que son las pantallas de la 7 a la 13
 */
class Meteor implements GL_sprite {
  properties : 
    type= null;
    game=null;
    incAngle=0;
    touch_for_die=10;
  virtual _operator_new(_name, _creator, _params) {
    game= _params[0];
    //_x = _params[1];
    //_y = _params[2];

    //Animación de muerte
   
    SetVisible(false);
		SetStop(true);
		SetCollision(false);
    incAngle=frand(-0.1, 0.90);
  }
  function create_type(){
     _type=rand(0,6);
    Addanimationwithsheet("asteroid","res/asteroides.png",_type,_type,0,0,76,76,-1,-1,-1,.2);
    Addanimationwithsheet("asteroid-dead","res/asteroides.png",0,4,0,76*2,76,76,-1,-1,-1,.2);
  }

  virtual Move() {  
    if(GetCurAnimation() =="asteroid-dead" && GetAnimationLoops()>0){
			//Destroy();
      SetVisible(false);
			SetStop(true);
			SetCollision(false);
			SetPos(-100,-100);
      touch_for_die=10;
      SetCurAnimation("asteroid");
			return;
		} 
    incpos(0, 0.5);
    IncAngle(incAngle);
    if(GetY() > GetApp().BOARD_HEIGHT-GetHeight()) game.delete_meteor(this);
  }
}